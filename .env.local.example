# API base URL for the VEIN backend (Spring Boot)
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# Real-time price feed (STOMP over SockJS at "<ws_base>/ws", topic
# /topic/prices). It is OPT-IN: enable it with NEXT_PUBLIC_LIVE_WS=true, or by
# setting an explicit NEXT_PUBLIC_WS_BASE below. When neither is set the UI
# falls back to REST polling (the documented graceful-degradation path) and
# never opens a socket — this keeps CI/smoke clean when /ws is unreachable.
# NEXT_PUBLIC_LIVE_WS=true

# Optional override for the WebSocket base. When unset it is derived from
# NEXT_PUBLIC_API_BASE by stripping /api/v1. Setting this also turns the feed
# on. Skipped entirely in mock mode.
# NEXT_PUBLIC_WS_BASE=http://localhost:8080

# Set to "true" to run the UI without a backend (mock axios adapter + seeded data)
NEXT_PUBLIC_USE_MOCK=true
